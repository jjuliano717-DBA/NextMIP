RewriteEngine On

# ── HTTPS & non-www redirect (Combined for Performance) ────────────────────
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://nextmip.com/$1 [L,R=301]

# php -- BEGIN cPanel-generated handler, do not edit
# Set the "ea-php83" package as the default "PHP" programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php83___lsphp .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit

# ─────────────────────────────────────────────────────────────────────────────
# NextMIP — URL Rewrites, Redirects & Performance
# ─────────────────────────────────────────────────────────────────────────────

Options -Indexes
DirectoryIndex index.html

# RULE 1: Trailing-slash → .html  (e.g. /about/ → /about.html)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} ^(.+)/$
RewriteCond %{DOCUMENT_ROOT}%1.html -f
RewriteRule ^(.+)/$ /$1.html [L,R=301]

# RULE 2: Extensionless → .html  (e.g. /about → /about.html)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}.html -f
RewriteRule ^(.+)$ /$1.html [L,R=301]

# Known Google-indexed trailing-slash URLs — explicit 301 fallback
Redirect 301 /managed-it-vs-managed-intelligence/ /managed-it-vs-managed-intelligence.html
Redirect 301 /what-is-a-managed-intelligence-provider/ /what-is-a-managed-intelligence-provider.html
Redirect 301 /client-portal/ /client-portal.html
Redirect 301 /about/ /about.html
Redirect 301 /sitemap/ /sitemap.html
Redirect 301 /privacy/ /privacy.html
Redirect 301 /terms/ /terms.html

# 404 fallback → homepage
ErrorDocument 404 /index.html

# ── Browser caching ───────────────────────────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html              "access plus 1 day"
    ExpiresByType text/css               "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/png              "access plus 6 months"
    ExpiresByType image/jpeg             "access plus 6 months"
    ExpiresByType image/webp             "access plus 6 months"
    ExpiresByType image/svg+xml          "access plus 6 months"
    ExpiresByType image/x-icon          "access plus 1 year"
    ExpiresByType application/xml        "access plus 1 week"
    ExpiresByType text/xml               "access plus 1 week"
</IfModule>

# ── Security headers ──────────────────────────────────────────────────────
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Block hidden files (.git, .env, etc.)
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>
